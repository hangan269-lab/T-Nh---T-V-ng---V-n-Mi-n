{
  "entities": {
    "SystemMeta": {
      "title": "SystemMeta",
      "description": "Studio workspace initialization status.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "enum": ["nhavuongmien_studio"] },
        "isSampleData": { "type": "boolean" },
        "seeded": { "type": "boolean" },
        "appIcon": { "type": "string", "maxLength": 64 },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "workspaceId", "isSampleData", "seeded", "serverCreatedAt", "serverUpdatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Product catalog item with brand, cost/sell price, initial stock, and adjustments.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "enum": ["nhavuongmien_studio"] },
        "code": { "type": "string", "maxLength": 40 },
        "name": { "type": "string", "maxLength": 160 },
        "brand": { "type": "string", "enum": ["Tơ Nhã", "Tơ Vương", "Vân Miên"] },
        "costPrice": { "type": "number" },
        "sellPrice": { "type": "number" },
        "initialStock": { "type": "object" },
        "stockAdjustments": { "type": "object" },
        "isArchived": { "type": "boolean" },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "workspaceId", "code", "name", "brand", "costPrice", "sellPrice", "initialStock", "serverCreatedAt", "serverUpdatedAt"]
    },
    "StockImport": {
      "title": "StockImport",
      "description": "Inventory import transaction for a specific product and size.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "enum": ["nhavuongmien_studio"] },
        "date": { "type": "string", "maxLength": 20 },
        "productId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "size": { "type": "string", "enum": ["S", "M", "L", "Freesize"] },
        "quantity": { "type": "number" },
        "unitCost": { "type": "number" },
        "note": { "type": "string", "maxLength": 500 },
        "enteredBy": { "type": "string", "maxLength": 160 },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "workspaceId", "date", "productId", "size", "quantity", "unitCost", "serverCreatedAt", "serverUpdatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer sales order with items, shipping details, COD/payment status, and audit attribution.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "enum": ["nhavuongmien_studio"] },
        "code": { "type": "string", "maxLength": 40 },
        "date": { "type": "string", "maxLength": 20 },
        "brand": { "type": "string", "enum": ["Tơ Nhã", "Tơ Vương", "Vân Miên"] },
        "customerName": { "type": "string", "maxLength": 160 },
        "customerPhone": { "type": "string", "maxLength": 32 },
        "shippingAddress": { "type": "string", "maxLength": 500 },
        "shippingMethod": { "type": "string", "enum": ["Viettel Post", "Ship nội thành", "Khách tự lấy"] },
        "shopShippingCost": { "type": "number" },
        "shippingCostPayer": { "type": "string", "maxLength": 160 },
        "shippingStatus": { "type": "string", "enum": ["Chưa gửi", "Đã lên đơn VTP", "Đã giao"] },
        "weightGrams": { "type": "number" },
        "items": { "type": "array", "description": "Order line items (1..30)" },
        "shippingFee": { "type": "number" },
        "discount": { "type": "number", "description": "Optional promotional order discount in VND" },
        "note": { "type": "string", "maxLength": 500 },
        "paymentStatus": { "type": "string", "enum": ["Chưa thanh toán", "Đã thanh toán"] },
        "isCancelled": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "createdBy": { "type": "string", "maxLength": 160 },
        "paymentConfirmedBy": { "type": "string", "maxLength": 160 },
        "paymentConfirmedAt": { "type": "string", "maxLength": 64 },
        "cancelledBy": { "type": "string", "maxLength": 160 },
        "cancelledAt": { "type": "string", "maxLength": 64 },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "workspaceId", "code", "date", "brand", "customerName", "customerPhone", "shippingAddress",
        "shippingMethod", "shopShippingCost", "shippingCostPayer", "shippingStatus",
        "weightGrams", "items", "shippingFee", "note", "paymentStatus", "isCancelled",
        "createdAt", "createdBy", "serverCreatedAt", "serverUpdatedAt"
      ]
    },
    "Shareholder": {
      "title": "Shareholder",
      "description": "Studio capital contributor / shareholder record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "enum": ["nhavuongmien_studio"] },
        "name": { "type": "string", "maxLength": 160 },
        "contribution": { "type": "number" },
        "note": { "type": "string", "maxLength": 500 },
        "updatedBy": { "type": "string", "maxLength": 160 },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "workspaceId", "name", "contribution", "serverCreatedAt", "serverUpdatedAt"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Operating or shipping expense entry synchronized with orders and cash fund.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "enum": ["nhavuongmien_studio"] },
        "linkedOrderId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "linkedImportId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "maxLength": 20 },
        "category": { "type": "string", "maxLength": 80 },
        "brandScope": { "type": "string", "enum": ["Tơ Nhã", "Tơ Vương", "Vân Miên", "Dùng chung"] },
        "detail": { "type": "string", "maxLength": 500 },
        "amount": { "type": "number" },
        "paidBy": { "type": "string", "maxLength": 160 },
        "receiptNote": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["Chưa", "Hoàn thiện"] },
        "enteredBy": { "type": "string", "maxLength": 160 },
        "updatedBy": { "type": "string", "maxLength": 160 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "workspaceId", "date", "category", "brandScope", "detail", "amount", "paidBy",
        "receiptNote", "status", "serverCreatedAt", "serverUpdatedAt"
      ]
    },
    "BudgetItem": {
      "title": "BudgetItem",
      "description": "Planned inventory or marketing budget line item.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "enum": ["nhavuongmien_studio"] },
        "category": { "type": "string", "maxLength": 80 },
        "detail": { "type": "string", "maxLength": 500 },
        "quantity": { "type": "number" },
        "estimatedUnitPrice": { "type": "number" },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "workspaceId", "category", "detail", "quantity", "estimatedUnitPrice", "serverCreatedAt", "serverUpdatedAt"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Team operator profile with role and 4-digit PIN.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "enum": ["nhavuongmien_studio"] },
        "name": { "type": "string", "maxLength": 160 },
        "username": { "type": "string", "maxLength": 64 },
        "role": { "type": "string", "enum": ["Admin", "Thành viên"] },
        "pin": { "type": "string", "minLength": 4, "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "workspaceId", "name", "username", "role", "pin", "createdAt", "serverCreatedAt", "serverUpdatedAt"]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "Audit trail record for orders, inventory, finance, and accounts.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "enum": ["nhavuongmien_studio"] },
        "timestamp": { "type": "string", "maxLength": 64 },
        "actorId": { "type": "string", "maxLength": 128 },
        "actorName": { "type": "string", "maxLength": 160 },
        "category": { "type": "string", "enum": ["Đơn hàng", "Tài chính", "Kho hàng", "Tài khoản", "Hệ thống"] },
        "action": { "type": "string", "maxLength": 160 },
        "detail": { "type": "string", "maxLength": 500 },
        "oldValue": { "type": "string", "maxLength": 500 },
        "newValue": { "type": "string", "maxLength": 500 },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "workspaceId", "timestamp", "actorId", "actorName", "category", "action", "detail", "serverCreatedAt", "serverUpdatedAt"]
    },
    "BackupSnapshot": {
      "title": "BackupSnapshot",
      "description": "Automatic pre-delete full workspace snapshot stored before destructive actions for 1-click recovery.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "enum": ["nhavuongmien_studio"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "actorId": { "type": "string", "maxLength": 128 },
        "actorName": { "type": "string", "maxLength": 160 },
        "category": { "type": "string", "enum": ["Đơn hàng", "Tài chính", "Kho hàng", "Tài khoản", "Hệ thống"] },
        "action": { "type": "string", "maxLength": 160 },
        "detail": { "type": "string", "maxLength": 500 },
        "summary": { "type": "object", "description": "Counts of records preserved in this backup snapshot." },
        "snapshot": { "type": "object", "description": "Native map containing products, stockImports, orders, shareholders, expenses, budgetItems, accounts, and chinaPartners lists." },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "workspaceId", "createdAt", "actorId", "actorName", "category", "action", "detail", "summary", "snapshot", "serverCreatedAt", "serverUpdatedAt"]
    },
    "ChinaPartner": {
      "title": "ChinaPartner",
      "description": "China Sourcing Partner / Supplier record for market expansion.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "enum": ["nhavuongmien_studio"] },
        "name": { "type": "string", "maxLength": 160 },
        "region": { "type": "string", "maxLength": 160 },
        "specialty": { "type": "string", "maxLength": 500 },
        "contactWeChat": { "type": "string", "maxLength": 64 },
        "phoneOrWhatsApp": { "type": "string", "maxLength": 32 },
        "channel": { "type": "string", "enum": ["Tiểu ngạch", "Chính ngạch", "Kho trung chuyển", "Giao biên giới"] },
        "exchangeRateCNY": { "type": "number" },
        "rating": { "type": "number" },
        "status": { "type": "string", "enum": ["Hợp tác thường xuyên", "Tiềm năng", "Tạm ngưng"] },
        "notes": { "type": "string", "maxLength": 500 },
        "lastOrderDate": { "type": "string", "maxLength": 20 },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "serverUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "workspaceId", "name", "region", "specialty", "channel", "exchangeRateCNY", "rating", "status", "serverCreatedAt", "serverUpdatedAt"]
    }
  },
  "firestore": {
    "/system/{docId}": {
      "schema": { "$ref": "#/entities/SystemMeta" },
      "description": "Studio workspace initialization metadata and sample-data status."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Product catalog and stock adjustment records synced in real time."
    },
    "/stockImports/{importId}": {
      "schema": { "$ref": "#/entities/StockImport" },
      "description": "Stock import batches synced in real time."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer sales orders synced in real time."
    },
    "/shareholders/{shareholderId}": {
      "schema": { "$ref": "#/entities/Shareholder" },
      "description": "Shareholder capital contributions synced in real time."
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Operating and shipping expenses synced in real time."
    },
    "/budgetItems/{budgetId}": {
      "schema": { "$ref": "#/entities/BudgetItem" },
      "description": "Planned budget items synced in real time."
    },
    "/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Team member POS/ERP accounts synced in real time."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLogEntry" },
      "description": "Audit log entries synced in real time."
    },
    "/backups/{backupId}": {
      "schema": { "$ref": "#/entities/BackupSnapshot" },
      "description": "Automatic pre-delete snapshots synced in real time for safe recovery."
    },
    "/chinaPartners/{partnerId}": {
      "schema": { "$ref": "#/entities/ChinaPartner" },
      "description": "China sourcing partners and market expansion directory."
    }
  }
}
