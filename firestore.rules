rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Validation & Workspace Primitives
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isStudioWorkspace(data) {
      return data.workspaceId == 'nhavuongmien_studio';
    }

    function isLegacyOrStudioWorkspace(data) {
      return !('workspaceId' in data) || data.workspaceId == 'nhavuongmien_studio';
    }

    function hasValidBaseMeta(data) {
      return data.workspaceId == 'nhavuongmien_studio' &&
        data.serverCreatedAt is timestamp &&
        data.serverUpdatedAt is timestamp;
    }

    function hasValidCreateMeta(data) {
      return data.workspaceId == 'nhavuongmien_studio' &&
        data.serverCreatedAt == request.time &&
        data.serverUpdatedAt == request.time;
    }

    function hasValidUpdateMeta() {
      return incoming().workspaceId == 'nhavuongmien_studio' &&
        (!('serverCreatedAt' in existing()) || incoming().serverCreatedAt == existing().serverCreatedAt) &&
        incoming().serverUpdatedAt == request.time;
    }

    function isOptString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidStockMap(m) {
      return m is map &&
        m.keys().hasOnly(['S', 'M', 'L', 'Freesize']) &&
        (!('S' in m) || (m.S is number && m.S >= -100000 && m.S <= 100000)) &&
        (!('M' in m) || (m.M is number && m.M >= -100000 && m.M <= 100000)) &&
        (!('L' in m) || (m.L is number && m.L >= -100000 && m.L <= 100000)) &&
        (!('Freesize' in m) || (m.Freesize is number && m.Freesize >= -100000 && m.Freesize <= 100000));
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints (Schema + Size + Field Whitelist)
    // -------------------------------------------------------------------------
    function isValidSystemMeta(data) {
      return data.keys().hasAll(['id', 'workspaceId', 'isSampleData', 'seeded', 'serverCreatedAt', 'serverUpdatedAt']) &&
        data.keys().hasOnly(['id', 'workspaceId', 'isSampleData', 'seeded', 'appIcon', 'serverCreatedAt', 'serverUpdatedAt']) &&
        isValidId(data.id) &&
        data.isSampleData is bool &&
        data.seeded is bool &&
        isOptString(data, 'appIcon', 64) &&
        hasValidBaseMeta(data);
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'workspaceId', 'code', 'name', 'brand', 'costPrice', 'sellPrice', 'initialStock', 'serverCreatedAt', 'serverUpdatedAt']) &&
        data.keys().hasOnly(['id', 'workspaceId', 'code', 'name', 'brand', 'costPrice', 'sellPrice', 'initialStock', 'stockAdjustments', 'isArchived', 'serverCreatedAt', 'serverUpdatedAt']) &&
        isValidId(data.id) &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 40 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        data.brand in ['Tơ Nhã', 'Tơ Vương', 'Vân Miên'] &&
        data.costPrice is number && data.costPrice >= 0 && data.costPrice <= 1000000000 &&
        data.sellPrice is number && data.sellPrice >= 0 && data.sellPrice <= 1000000000 &&
        isValidStockMap(data.initialStock) &&
        (!('stockAdjustments' in data) || isValidStockMap(data.stockAdjustments)) &&
        (!('isArchived' in data) || data.isArchived is bool) &&
        hasValidBaseMeta(data);
    }

    function isValidStockImport(data) {
      return data.keys().hasAll(['id', 'workspaceId', 'date', 'productId', 'size', 'quantity', 'unitCost', 'serverCreatedAt', 'serverUpdatedAt']) &&
        data.keys().hasOnly(['id', 'workspaceId', 'date', 'productId', 'size', 'quantity', 'unitCost', 'note', 'enteredBy', 'serverCreatedAt', 'serverUpdatedAt']) &&
        isValidId(data.id) &&
        data.date is string && data.date.size() >= 8 && data.date.size() <= 20 &&
        isValidId(data.productId) &&
        data.size in ['S', 'M', 'L', 'Freesize'] &&
        data.quantity is number && data.quantity >= 1 && data.quantity <= 100000 &&
        data.unitCost is number && data.unitCost >= 0 && data.unitCost <= 1000000000 &&
        isOptString(data, 'note', 500) &&
        isOptString(data, 'enteredBy', 160) &&
        hasValidBaseMeta(data);
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'id', 'workspaceId', 'code', 'date', 'brand', 'customerName', 'customerPhone', 'shippingAddress',
          'shippingMethod', 'shopShippingCost', 'shippingCostPayer', 'shippingStatus',
          'weightGrams', 'items', 'shippingFee', 'note', 'paymentStatus', 'isCancelled',
          'createdAt', 'createdBy', 'serverCreatedAt', 'serverUpdatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'workspaceId', 'code', 'date', 'brand', 'customerName', 'customerPhone', 'shippingAddress',
          'shippingMethod', 'shopShippingCost', 'shippingCostPayer', 'shippingStatus',
          'weightGrams', 'items', 'shippingFee', 'discount', 'note', 'paymentStatus', 'isCancelled',
          'createdAt', 'createdBy', 'paymentConfirmedBy', 'paymentConfirmedAt',
          'cancelledBy', 'cancelledAt', 'serverCreatedAt', 'serverUpdatedAt'
        ]) &&
        isValidId(data.id) &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 40 &&
        data.date is string && data.date.size() >= 8 && data.date.size() <= 20 &&
        data.brand in ['Tơ Nhã', 'Tơ Vương', 'Vân Miên'] &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 160 &&
        data.customerPhone is string && data.customerPhone.size() >= 1 && data.customerPhone.size() <= 32 &&
        data.shippingAddress is string && data.shippingAddress.size() >= 1 && data.shippingAddress.size() <= 500 &&
        data.shippingMethod in ['Viettel Post', 'Ship nội thành', 'Khách tự lấy'] &&
        data.shopShippingCost is number && data.shopShippingCost >= 0 && data.shopShippingCost <= 100000000 &&
        data.shippingCostPayer is string && data.shippingCostPayer.size() <= 160 &&
        data.shippingStatus in ['Chưa gửi', 'Đã lên đơn VTP', 'Đã giao'] &&
        data.weightGrams is number && data.weightGrams >= 1 && data.weightGrams <= 1000000 &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 30 &&
        data.items[0] is map &&
        data.items[0].keys().hasAll(['productId', 'productCode', 'productName', 'size', 'quantity', 'unitPrice']) &&
        data.items[0].keys().hasOnly(['productId', 'productCode', 'productName', 'size', 'quantity', 'unitPrice']) &&
        data.items[0].productId is string && data.items[0].productId.size() <= 128 &&
        data.items[0].productCode is string && data.items[0].productCode.size() <= 40 &&
        data.items[0].productName is string && data.items[0].productName.size() <= 160 &&
        data.items[0].size in ['S', 'M', 'L', 'Freesize'] &&
        data.items[0].quantity is number && data.items[0].quantity >= 1 &&
        data.items[0].unitPrice is number && data.items[0].unitPrice >= 0 &&
        data.shippingFee is number && data.shippingFee >= 0 && data.shippingFee <= 100000000 &&
        (!('discount' in data) || (data.discount is number && data.discount >= 0 && data.discount <= 100000000)) &&
        data.note is string && data.note.size() <= 500 &&
        data.paymentStatus in ['Chưa thanh toán', 'Đã thanh toán'] &&
        data.isCancelled is bool &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.createdBy is string && data.createdBy.size() <= 160 &&
        isOptString(data, 'paymentConfirmedBy', 160) &&
        isOptString(data, 'paymentConfirmedAt', 64) &&
        isOptString(data, 'cancelledBy', 160) &&
        isOptString(data, 'cancelledAt', 64) &&
        hasValidBaseMeta(data);
    }

    function isValidShareholder(data) {
      return data.keys().hasAll(['id', 'workspaceId', 'name', 'contribution', 'serverCreatedAt', 'serverUpdatedAt']) &&
        data.keys().hasOnly(['id', 'workspaceId', 'name', 'contribution', 'note', 'updatedBy', 'serverCreatedAt', 'serverUpdatedAt']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        data.contribution is number && data.contribution >= 0 && data.contribution <= 100000000000 &&
        isOptString(data, 'note', 500) &&
        isOptString(data, 'updatedBy', 160) &&
        hasValidBaseMeta(data);
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['id', 'workspaceId', 'date', 'category', 'brandScope', 'detail', 'amount', 'paidBy', 'receiptNote', 'status', 'serverCreatedAt', 'serverUpdatedAt']) &&
        data.keys().hasOnly(['id', 'workspaceId', 'linkedOrderId', 'linkedImportId', 'date', 'category', 'brandScope', 'detail', 'amount', 'paidBy', 'receiptNote', 'status', 'enteredBy', 'updatedBy', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt']) &&
        isValidId(data.id) &&
        (!('linkedOrderId' in data) || isValidId(data.linkedOrderId)) &&
        (!('linkedImportId' in data) || isValidId(data.linkedImportId)) &&
        data.date is string && data.date.size() >= 8 && data.date.size() <= 20 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.brandScope in ['Tơ Nhã', 'Tơ Vương', 'Vân Miên', 'Dùng chung'] &&
        data.detail is string && data.detail.size() >= 1 && data.detail.size() <= 500 &&
        data.amount is number && data.amount >= 0 && data.amount <= 100000000000 &&
        data.paidBy is string && data.paidBy.size() >= 1 && data.paidBy.size() <= 160 &&
        data.receiptNote is string && data.receiptNote.size() <= 500 &&
        data.status in ['Chưa', 'Hoàn thiện'] &&
        isOptString(data, 'enteredBy', 160) &&
        isOptString(data, 'updatedBy', 160) &&
        isOptString(data, 'updatedAt', 64) &&
        hasValidBaseMeta(data);
    }

    function isValidBudgetItem(data) {
      return data.keys().hasAll(['id', 'workspaceId', 'category', 'detail', 'quantity', 'estimatedUnitPrice', 'serverCreatedAt', 'serverUpdatedAt']) &&
        data.keys().hasOnly(['id', 'workspaceId', 'category', 'detail', 'quantity', 'estimatedUnitPrice', 'serverCreatedAt', 'serverUpdatedAt']) &&
        isValidId(data.id) &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.detail is string && data.detail.size() >= 1 && data.detail.size() <= 500 &&
        data.quantity is number && data.quantity >= 1 && data.quantity <= 1000000 &&
        data.estimatedUnitPrice is number && data.estimatedUnitPrice >= 0 && data.estimatedUnitPrice <= 100000000000 &&
        hasValidBaseMeta(data);
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll(['id', 'workspaceId', 'name', 'username', 'role', 'pin', 'createdAt', 'serverCreatedAt', 'serverUpdatedAt']) &&
        data.keys().hasOnly(['id', 'workspaceId', 'name', 'username', 'role', 'pin', 'createdAt', 'serverCreatedAt', 'serverUpdatedAt']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 64 &&
        data.role in ['Admin', 'Thành viên'] &&
        data.pin is string && data.pin.size() >= 4 && data.pin.size() <= 32 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        hasValidBaseMeta(data);
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'workspaceId', 'timestamp', 'actorId', 'actorName', 'category', 'action', 'detail', 'serverCreatedAt', 'serverUpdatedAt']) &&
        data.keys().hasOnly(['id', 'workspaceId', 'timestamp', 'actorId', 'actorName', 'category', 'action', 'detail', 'oldValue', 'newValue', 'serverCreatedAt', 'serverUpdatedAt']) &&
        isValidId(data.id) &&
        data.timestamp is string && data.timestamp.size() <= 64 &&
        data.actorId is string && data.actorId.size() <= 128 &&
        data.actorName is string && data.actorName.size() <= 160 &&
        data.category in ['Đơn hàng', 'Tài chính', 'Kho hàng', 'Tài khoản', 'Hệ thống'] &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 160 &&
        data.detail is string && data.detail.size() >= 1 && data.detail.size() <= 500 &&
        isOptString(data, 'oldValue', 500) &&
        isOptString(data, 'newValue', 500) &&
        hasValidBaseMeta(data);
    }

    function isValidBackupSummary(s) {
      return s is map &&
        s.keys().hasAll([
          'productsCount', 'stockImportsCount', 'ordersCount',
          'shareholdersCount', 'expensesCount', 'budgetItemsCount', 'accountsCount'
        ]) &&
        s.keys().hasOnly([
          'productsCount', 'stockImportsCount', 'ordersCount',
          'shareholdersCount', 'expensesCount', 'budgetItemsCount', 'accountsCount'
        ]) &&
        s.productsCount is number && s.productsCount >= 0 &&
        s.stockImportsCount is number && s.stockImportsCount >= 0 &&
        s.ordersCount is number && s.ordersCount >= 0 &&
        s.shareholdersCount is number && s.shareholdersCount >= 0 &&
        s.expensesCount is number && s.expensesCount >= 0 &&
        s.budgetItemsCount is number && s.budgetItemsCount >= 0 &&
        s.accountsCount is number && s.accountsCount >= 0;
    }

    function isValidBackupPayloadMap(snap) {
      return snap is map &&
        snap.keys().hasAll(['products', 'stockImports', 'orders', 'shareholders', 'expenses', 'budgetItems', 'accounts', 'chinaPartners']) &&
        snap.keys().hasOnly(['products', 'stockImports', 'orders', 'shareholders', 'expenses', 'budgetItems', 'accounts', 'chinaPartners']) &&
        snap.products is list && snap.products.size() <= 500 &&
        snap.stockImports is list && snap.stockImports.size() <= 1000 &&
        snap.orders is list && snap.orders.size() <= 1000 &&
        snap.shareholders is list && snap.shareholders.size() <= 100 &&
        snap.expenses is list && snap.expenses.size() <= 1000 &&
        snap.budgetItems is list && snap.budgetItems.size() <= 500 &&
        snap.accounts is list && snap.accounts.size() <= 100 &&
        snap.chinaPartners is list && snap.chinaPartners.size() <= 200;
    }

    function isValidBackupSnapshot(data) {
      return data.keys().hasAll([
          'id', 'workspaceId', 'createdAt', 'actorId', 'actorName',
          'category', 'action', 'detail', 'summary', 'snapshot',
          'serverCreatedAt', 'serverUpdatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'workspaceId', 'createdAt', 'actorId', 'actorName',
          'category', 'action', 'detail', 'summary', 'snapshot',
          'serverCreatedAt', 'serverUpdatedAt'
        ]) &&
        isValidId(data.id) &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.actorId is string && data.actorId.size() <= 128 &&
        data.actorName is string && data.actorName.size() <= 160 &&
        data.category in ['Đơn hàng', 'Tài chính', 'Kho hàng', 'Tài khoản', 'Hệ thống'] &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 160 &&
        data.detail is string && data.detail.size() >= 1 && data.detail.size() <= 500 &&
        isValidBackupSummary(data.summary) &&
        isValidBackupPayloadMap(data.snapshot) &&
        hasValidBaseMeta(data);
    }

    function isValidChinaPartner(data) {
      return data.keys().hasAll(['id', 'workspaceId', 'name', 'region', 'specialty', 'channel', 'exchangeRateCNY', 'rating', 'status', 'serverCreatedAt', 'serverUpdatedAt']) &&
        data.keys().hasOnly(['id', 'workspaceId', 'name', 'region', 'specialty', 'contactWeChat', 'phoneOrWhatsApp', 'channel', 'exchangeRateCNY', 'rating', 'status', 'notes', 'lastOrderDate', 'serverCreatedAt', 'serverUpdatedAt']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        data.region is string && data.region.size() >= 1 && data.region.size() <= 160 &&
        data.specialty is string && data.specialty.size() >= 1 && data.specialty.size() <= 500 &&
        isOptString(data, 'contactWeChat', 64) &&
        isOptString(data, 'phoneOrWhatsApp', 32) &&
        data.channel in ['Tiểu ngạch', 'Chính ngạch', 'Kho trung chuyển', 'Giao biên giới'] &&
        data.exchangeRateCNY is number && data.exchangeRateCNY >= 1000 && data.exchangeRateCNY <= 10000 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.status in ['Hợp tác thường xuyên', 'Tiềm năng', 'Tạm ngưng'] &&
        isOptString(data, 'notes', 500) &&
        isOptString(data, 'lastOrderDate', 20) &&
        hasValidBaseMeta(data);
    }

    // -------------------------------------------------------------------------
    // Collection Match Rules (Workspace-Scoped Cloud Sync + Anonymous Auth Gate)
    // -------------------------------------------------------------------------
    match /system/{docId} {
      allow get: if isSignedIn() && isValidId(docId) && isLegacyOrStudioWorkspace(existing());
      allow list: if isSignedIn() && isStudioWorkspace(existing());
      allow create: if isSignedIn() && isValidId(docId) && isValidSystemMeta(incoming()) && hasValidCreateMeta(incoming());
      allow update: if isSignedIn() && isValidId(docId) && isValidSystemMeta(incoming()) && isLegacyOrStudioWorkspace(existing()) && hasValidUpdateMeta();
      allow delete: if isSignedIn() && isValidId(docId) && isLegacyOrStudioWorkspace(existing());
    }

    match /products/{productId} {
      allow get: if isSignedIn() && isValidId(productId) && isLegacyOrStudioWorkspace(existing());
      allow list: if isSignedIn() && isStudioWorkspace(existing());
      allow create: if isSignedIn() && isValidId(productId) && isValidProduct(incoming()) && hasValidCreateMeta(incoming());
      allow update: if isSignedIn() && isValidId(productId) && isValidProduct(incoming()) && isLegacyOrStudioWorkspace(existing()) && hasValidUpdateMeta();
      allow delete: if isSignedIn() && isValidId(productId) && isLegacyOrStudioWorkspace(existing());
    }

    match /stockImports/{importId} {
      allow get: if isSignedIn() && isValidId(importId) && isLegacyOrStudioWorkspace(existing());
      allow list: if isSignedIn() && isStudioWorkspace(existing());
      allow create: if isSignedIn() && isValidId(importId) && isValidStockImport(incoming()) && hasValidCreateMeta(incoming());
      allow update: if isSignedIn() && isValidId(importId) && isValidStockImport(incoming()) && isLegacyOrStudioWorkspace(existing()) && hasValidUpdateMeta();
      allow delete: if isSignedIn() && isValidId(importId) && isLegacyOrStudioWorkspace(existing());
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && isLegacyOrStudioWorkspace(existing());
      allow list: if isSignedIn() && isStudioWorkspace(existing());
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming()) && hasValidCreateMeta(incoming());
      allow update: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming()) && isLegacyOrStudioWorkspace(existing()) && hasValidUpdateMeta();
      allow delete: if isSignedIn() && isValidId(orderId) && isLegacyOrStudioWorkspace(existing());
    }

    match /shareholders/{shareholderId} {
      allow get: if isSignedIn() && isValidId(shareholderId) && isLegacyOrStudioWorkspace(existing());
      allow list: if isSignedIn() && isStudioWorkspace(existing());
      allow create: if isSignedIn() && isValidId(shareholderId) && isValidShareholder(incoming()) && hasValidCreateMeta(incoming());
      allow update: if isSignedIn() && isValidId(shareholderId) && isValidShareholder(incoming()) && isLegacyOrStudioWorkspace(existing()) && hasValidUpdateMeta();
      allow delete: if isSignedIn() && isValidId(shareholderId) && isLegacyOrStudioWorkspace(existing());
    }

    match /expenses/{expenseId} {
      allow get: if isSignedIn() && isValidId(expenseId) && isLegacyOrStudioWorkspace(existing());
      allow list: if isSignedIn() && isStudioWorkspace(existing());
      allow create: if isSignedIn() && isValidId(expenseId) && isValidExpense(incoming()) && hasValidCreateMeta(incoming());
      allow update: if isSignedIn() && isValidId(expenseId) && isValidExpense(incoming()) && isLegacyOrStudioWorkspace(existing()) && hasValidUpdateMeta();
      allow delete: if isSignedIn() && isValidId(expenseId) && isLegacyOrStudioWorkspace(existing());
    }

    match /budgetItems/{budgetId} {
      allow get: if isSignedIn() && isValidId(budgetId) && isLegacyOrStudioWorkspace(existing());
      allow list: if isSignedIn() && isStudioWorkspace(existing());
      allow create: if isSignedIn() && isValidId(budgetId) && isValidBudgetItem(incoming()) && hasValidCreateMeta(incoming());
      allow update: if isSignedIn() && isValidId(budgetId) && isValidBudgetItem(incoming()) && isLegacyOrStudioWorkspace(existing()) && hasValidUpdateMeta();
      allow delete: if isSignedIn() && isValidId(budgetId) && isLegacyOrStudioWorkspace(existing());
    }

    match /accounts/{accountId} {
      allow get: if isSignedIn() && isValidId(accountId) && isLegacyOrStudioWorkspace(existing());
      allow list: if isSignedIn() && isStudioWorkspace(existing());
      allow create: if isSignedIn() && isValidId(accountId) && isValidUserAccount(incoming()) && hasValidCreateMeta(incoming());
      allow update: if isSignedIn() && isValidId(accountId) && isValidUserAccount(incoming()) && isLegacyOrStudioWorkspace(existing()) && hasValidUpdateMeta();
      allow delete: if isSignedIn() && isValidId(accountId) && isLegacyOrStudioWorkspace(existing());
    }

    match /auditLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && isLegacyOrStudioWorkspace(existing());
      allow list: if isSignedIn() && isStudioWorkspace(existing());
      allow create: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming()) && hasValidCreateMeta(incoming());
      allow update: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming()) && isLegacyOrStudioWorkspace(existing()) && hasValidUpdateMeta();
      allow delete: if isSignedIn() && isValidId(logId) && isLegacyOrStudioWorkspace(existing());
    }

    match /backups/{backupId} {
      allow get: if isSignedIn() && isValidId(backupId) && isLegacyOrStudioWorkspace(existing());
      allow list: if isSignedIn() && isStudioWorkspace(existing());
      allow create: if isSignedIn() && isValidId(backupId) && isValidBackupSnapshot(incoming()) && hasValidCreateMeta(incoming());
      allow update: if isSignedIn() && isValidId(backupId) && isValidBackupSnapshot(incoming()) && isLegacyOrStudioWorkspace(existing()) && hasValidUpdateMeta();
      allow delete: if isSignedIn() && isValidId(backupId) && isLegacyOrStudioWorkspace(existing());
    }

    match /chinaPartners/{partnerId} {
      allow get: if isSignedIn() && isValidId(partnerId) && isLegacyOrStudioWorkspace(existing());
      allow list: if isSignedIn() && isStudioWorkspace(existing());
      allow create: if isSignedIn() && isValidId(partnerId) && isValidChinaPartner(incoming()) && hasValidCreateMeta(incoming());
      allow update: if isSignedIn() && isValidId(partnerId) && isValidChinaPartner(incoming()) && isLegacyOrStudioWorkspace(existing()) && hasValidUpdateMeta();
      allow delete: if isSignedIn() && isValidId(partnerId) && isLegacyOrStudioWorkspace(existing());
    }
  }
}
